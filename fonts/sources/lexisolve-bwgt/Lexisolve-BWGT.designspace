<?xml version='1.0' encoding='UTF-8'?>
<designspace format="5.0">
  <!-- 
    Lexisolve BWGT Variable Font Designspace
    
    BWGT (Bottom Weight) Axis:
    - Custom axis for dyslexia research
    - Range: 0 to 100
    - 0 = Uniform stroke weight (standard)
    - 100 = Maximum bottom-heavy distribution
  -->
  
  <axes>
    <axis tag="BWGT" name="Bottom Weight" minimum="0" default="0" maximum="100">
      <labelname xml:lang="en">Bottom Weight</labelname>
    </axis>
  </axes>
  
  <sources>
    <!-- BWGT 0: Baseline (uniform stroke weight) -->
    <source filename="Lexisolve-BWGT0.ufo" familyname="Lexisolve" stylename="Regular">
      <location>
        <dimension name="Bottom Weight" xvalue="0"/>
      </location>
    </source>
    
    <!-- BWGT 50: Moderate bottom weight -->
    <source filename="Lexisolve-BWGT50.ufo" familyname="Lexisolve" stylename="BWGT50">
      <location>
        <dimension name="Bottom Weight" xvalue="50"/>
      </location>
    </source>
    
    <!-- BWGT 100: Maximum bottom weight -->
    <source filename="Lexisolve-BWGT100.ufo" familyname="Lexisolve" stylename="BWGT100">
      <location>
        <dimension name="Bottom Weight" xvalue="100"/>
      </location>
    </source>
  </sources>
  
  <instances>
    <!-- Pre-defined instances for testing -->
    <instance name="Lexisolve Regular" familyname="Lexisolve" stylename="Regular" filename="instances/Lexisolve-Regular.ufo">
      <location>
        <dimension name="Bottom Weight" xvalue="0"/>
      </location>
    </instance>
    
    <instance name="Lexisolve Light Bottom" familyname="Lexisolve" stylename="LightBottom" filename="instances/Lexisolve-LightBottom.ufo">
      <location>
        <dimension name="Bottom Weight" xvalue="25"/>
      </location>
    </instance>
    
    <instance name="Lexisolve Medium Bottom" familyname="Lexisolve" stylename="MediumBottom" filename="instances/Lexisolve-MediumBottom.ufo">
      <location>
        <dimension name="Bottom Weight" xvalue="50"/>
      </location>
    </instance>
    
    <instance name="Lexisolve Heavy Bottom" familyname="Lexisolve" stylename="HeavyBottom" filename="instances/Lexisolve-HeavyBottom.ufo">
      <location>
        <dimension name="Bottom Weight" xvalue="75"/>
      </location>
    </instance>
    
    <instance name="Lexisolve Max Bottom" familyname="Lexisolve" stylename="MaxBottom" filename="instances/Lexisolve-MaxBottom.ufo">
      <location>
        <dimension name="Bottom Weight" xvalue="100"/>
      </location>
    </instance>
  </instances>
  
</designspace>